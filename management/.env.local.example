# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# Airtable Personal Access Token (server-only — never exposed to the client).
# Needs data.records:read + data.records:write scopes on the LCP - Airbnb base.
AIRTABLE_API_KEY=

# Base: LCP - Airbnb
AIRTABLE_BASE_ID=appQEf53xzRNYDRZT

# Table IDs (stable even if tables are renamed in the Airtable UI)
AIRTABLE_TABLE_UNITS=tblhUiksFJyU19mSM
AIRTABLE_TABLE_JOBS=tblT62DQUgyfB5s0u
AIRTABLE_TABLE_BUNDLES=tblxhYY3LkRvE1YrE
AIRTABLE_TABLE_STAFF=tblRmX5qXtI5o7g2i
AIRTABLE_TABLE_REPORTS=tblErB0MFaMkXfFM3

# Random secret used to sign the login session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
