# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. When set, the app uses it instead of the anon key. Required before the
# public "app access" RLS policies are removed. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# HMAC key for verification codes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# n8n webhooks used for SMS. The OTP webhook checks the shared secret (sent as X-Webhook-Secret);
# the secret must match the one embedded in the "LCP - Auth OTP SMS" workflow.
N8N_OTP_WEBHOOK_URL=https://n8n.bakerasystems.com/webhook/lcp-otp
N8N_NOTIFY_WEBHOOK_URL=https://n8n.bakerasystems.com/webhook/lcp-notify
N8N_WEBHOOK_SECRET=

# Local development only: print the sign-in code to the server log when n8n isn't reachable.
# Ignored in production.
AUTH_DEV_LOG_CODES=false

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# true (default) = in-memory fake data, no Supabase. Set to false for real data.
PILOT_USE_FAKE_DATA=true
# Fake mode only: cleaner | owner | manager | multi | admin
PILOT_FAKE_ROLE=cleaner
